, 86.2, "门"], [86.2, 86.36, "为"], [86.36, 86.58, "我们"], [86.58, 86.9, "准"], [86.9, 86.96, "备"], [86.96, 87.5, "的。"]]}, {"start": 87.8, "end": 95.3, "text": "作家道格拉斯·亚当斯讲过一个故事,一个水坑醒来,发现自己呆的坑形状刚刚好。", "words": [[87.8, 88.0, "作"], [88.0, 88.22, "家"], [88.22, 88.44, "道"], [88.44, 88.62, "格"], [88.62, 88.8, "拉"], [88.8, 89.02, "斯"], [89.02, 89.02, "·"], [89.02, 89.2, "亚"], [89.2, 89.4, "当"], [89.4, 89.84, "斯"], [89.84, 90.12, "讲"], [90.12, 90.3, "过"], [90.3, 90.52, "一个"], [90.52, 90.88, "故"], [90.88, 91.16, "事,"], [91.52, 91.76, "一个"], [91.76, 92.08, "水"], [92.08, 92.18, "坑"], [92.18, 92.52, "醒"], [92.52, 92.7, "来,"], [92.78, 92.94, "发"], [92.94, 93.04, "现"], [93.04, 93.32, "自己"], [93.32, 93.46, "呆"], [93.46, 93.62, "的"], [93.62, 93.9, "坑"], [93.9, 94.22, "形"], [94.22, 94.36, "状"], [94.36, 94.64, "刚"], [94.64, 94.82, "刚"], [94.82, 95.3, "好。"]]}, {"start": 95.88, "end": 103.9, "text": "言思河粉,他想这个坑一定是专门为我挖的,直到太阳升起,自己一点点蒸发,他还这么相信。", "words": [[95.88, 96.04, "言"], [96.04, 96.18, "思"], [96.18, 96.42, "河"], [96.42, 96.64, "粉,"], [96.9, 97.1, "他"], [97.1, 97.3, "想"], [97.3, 97.6, "这个"], [97.6, 97.78, "坑"], [97.78, 98.1, "一定"], [98.1, 98.26, "是"], [98.26, 98.46, "专"], [98.46, 98.58, "门"], [98.58, 98.72, "为"], [98.72, 98.92, "我"], [98.92, 99.06, "挖"], [99.06, 99.64, "的,"], [99.88, 100.04, "直"], [100.04, 100.14, "到"], [100.14, 100.32, "太"], [100.32, 100.46, "阳"], [100.46, 100.74, "升"], [100.74, 101.02, "起,"], [101.2, 101.56, "自己"], [101.56, 101.88, "一点"], [101.88, 102.1, "点"], [102.1, 102.38, "蒸"], [102.38, 102.68, "发,"], [102.78, 103.0, "他"], [103.0, 103.2, "还"], [103.2, 103.46, "这么"], [103.46, 103.9, "相信。"]]}, {"start": 103.9, "end": 110.2, "text": "可不是坑适合水,是水本来就顺着坑的形状流成了这样。", "words": [[103.9, 104.56, "可"], [104.56, 104.84, "不是"], [104.84, 105.1, "坑"], [105.1, 105.32, "适"], [105.32, 105.54, "合"], [105.54, 105.9, "水,"], [106.28, 106.48, "是"], [106.48, 106.78, "水"], [106.78, 107.0, "本"], [107.0, 107.2, "来"], [107.2, 107.48, "就"], [107.48, 107.6, "顺"], [107.6, 107.76, "着"], [107.76, 