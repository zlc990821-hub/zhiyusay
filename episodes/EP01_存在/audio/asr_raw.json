, "六"], [22.68, 22.88, "千"], [22.88, 22.96, "六"], [22.96, 23.12, "百"], [23.12, 23.22, "万"], [23.22, 23.68, "年前,"], [23.74, 23.96, "一"], [23.96, 24.02, "颗"], [24.02, 24.24, "约"], [24.24, 24.52, "十"], [24.52, 24.72, "公"], [24.72, 24.8, "里"], [24.8, 24.98, "宽"], [24.98, 25.16, "的"], [25.16, 25.34, "小"], [25.34, 25.52, "行"], [25.52, 25.66, "星"], [25.66, 25.88, "撞"], [25.88, 26.04, "上"], [26.04, 26.34, "地"], [26.34, 26.56, "球,"], [26.72, 26.88, "恐"], [26.88, 27.08, "龙"], [27.08, 27.32, "几"], [27.32, 27.5, "乎"], [27.5, 27.76, "全部"], [27.76, 28.1, "消"], [28.1, 28.54, "失,"], [28.82, 29.0, "一些"], [29.0, 29.26, "小"], [29.26, 29.38, "型"], [29.38, 29.62, "哺"], [29.62, 29.62, "乳"], [29.62, 29.84, "动"], [29.84, 29.9, "物"], [29.9, 30.12, "活"], [30.12, 30.28, "了"], [30.28, 30.42, "下"], [30.42, 30.82, "来,"], [30.94, 31.14, "其"], [31.14, 31.32, "中"], [31.32, 31.52, "就"], [31.52, 31.66, "有"], [31.66, 31.82, "我们"], [31.82, 32.0, "的"], [32.0, 32.2, "元"], [32.2, 32.66, "祖。"]]}, {"start": 32.8, "end": 40.16, "text": "有研究估算,只有约13%的地表被这样撞上才会引发大灭绝,它偏偏撞到了那里。", "words": [[32.8, 33.0, "有"], [33.0, 33.18, "研"], [33.18, 33.28, "究"], [33.28, 33.48, "估"], [33.48, 33.8, "算,"], [34.02, 34.32, "只有"], [34.32, 34.56, "约"], [34.56, 35.3, "13"], [35.3, 35.3, "%"], [35.3, 35.56, "的"], [35.56, 35.7, "地"], [35.7, 35.8, "表"], [35.8, 36.04, "被"], [36.04, 36.28, "这样"], [36.28, 36.58, "撞"], [36.58, 36.74, "上"], [36.74, 36.94, "才"], [36.94, 37.12, "会"], [37.12, 37.3, "引"], [37.3, 37.38, "发"], [37.38, 37.64, "大"], [37.64, 37.86, "灭"], [37.86, 38.36, "绝,"], [38.52, 38.86, "它"], [38.86, 39.1, "偏"], [39.1, 39.24, "偏"], [39.24, 39.38, "撞"], [39.38, 39.62, "到了"], [39.62, 39.86, "那"], [39.86, 40.16, "里。"]]}, {"start": 40.5, "end": 50.12, "text": "再把镜头拉远,巧合变得更夸张,宇宙只有一组基本的数字,就像一排旋钮,其中一些只要稍微拧一下就不会有你。", "words": [[40.5, 40.68, "再"], [40.68, 40.78, "把"], [40.78, 40.96, "镜"], [40.96, 41.08, "头"], [41.08, 41.36, "拉"], [41.36, 41.52, "远,"], [41.78, 41.94, "巧"], [41.94, 42.06, "合"], [42.06, 42.26, "变"], [42.26, 42.4, "得"], [42.4