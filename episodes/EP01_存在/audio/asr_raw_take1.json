06.88, "宇"], [106.88, 107.02, "宙"], [107.02, 107.24, "像"], [107.24, 107.38, "是"], [107.38, 107.58, "专"], [107.58, 107.68, "门"], [107.68, 107.86, "为"], [107.86, 108.08, "我们"], [108.08, 108.38, "准"], [108.38, 108.46, "备"], [108.46, 109.26, "的。"]]}, {"start": 109.26, "end": 129.04, "text": "作家道格拉斯亚丹斯讲过一个故事,一个水坑醒来,发现自己待的坑形状刚刚好,严丝合缝。", "words": [[109.26, 109.5, "作"], [109.5, 113.62, "家"], [113.62, 113.82, "道"], [113.82, 114.0, "格"], [114.0, 114.16, "拉"], [114.16, 116.64, "斯"], [116.64, 116.84, "亚"], [116.84, 117.1, "丹"], [117.1, 117.38, "斯"], [117.38, 117.6, "讲"], [117.6, 117.76, "过"], [117.76, 117.94, "一个"], [117.94, 118.26, "故"], [118.26, 118.76, "事,"], [118.84, 119.06, "一个"], [119.06, 119.4, "水"], [119.4, 119.6, "坑"], [119.6, 119.92, "醒"], [119.92, 120.44, "来,"], [120.62, 120.68, "发"], [120.68, 120.8, "现"], [120.8, 121.08, "自己"], [121.08, 121.24, "待"], [121.24, 126.62, "的"], [126.62, 126.88, "坑"], [126.88, 126.88, "形"], [126.88, 127.2, "状"], [127.2, 127.48, "刚"], [127.48, 127.66, "刚"], [127.66, 128.02, "好,"], [128.22, 128.36, "严"], [128.36, 128.5, "丝"], [128.5, 128.76, "合"], [128.76, 129.04, "缝。"]]}, {"start": 129.04, "end": 142.12, "text": "他想,这个坑一定是专门为我挖的,直到太阳升起,自己一点点蒸发,他还这么相信。可不是坑适合水,是谁本来就顺着坑的形状流成了这样。", "words": [[129.04, 129.42, "他"], [129.42, 129.74, "想,"], [129.86, 130.1, "这个"], [130.1, 130.36, "坑"], [130.36, 130.8, "一定"], [130.8, 130.98, "是"], [130.98, 131.24, "专"], [131.24, 131.36, "门"], [131.36, 131.52, "为"], [131.52, 131.72, "我"], [131.72, 131.9, "挖"], [131.9, 132.36, "的,"], [132.48, 132.58, "直"], [132.58, 132.68, "到"], [132.68, 132.9, "太"], [132.9, 133.02, "阳"], [133.02, 133.3, "升"], [133.3, 133.66, "起,"], [133.9, 134.12, "自己"], [134.12, 134.5, "一点"], [134.5, 134.72, "点"], [134.72, 134.96, "蒸"], [134.96, 135.14, "发,"], [135.38, 135.6, "他"], [135.6, 135.82, "还"], [135.82, 136.06, "这么"], [136.06, 136.58, "相信。"], [137.12, 137.3, "可"], [137.3, 137.72, "不是"], [137.72, 138.08, "坑"], [138.08, 138.28, "适"], [138.28, 138.5, "合"], [138.5, 138.68, "水,"], [138.88, 139.