, "他"], [189.44, 189.58, "说"], [189.58, 189.74, "明"], [189.74, 190.06, "不了"], [190.06, 190.64, "为什么"], [190.64, 190.9, "会"], [190.9, 191.02, "有"], [191.02, 191.28, "宇"], [191.28, 191.54, "宙。"]]}, {"start": 192.42, "end": 205.96, "text": "三百多年前,莱布尼斯把问题推到了尽头,为什么有东西存在,而不是什么都没有,到今天没有人能回答。", "words": [[192.42, 192.48, "三"], [192.48, 192.6, "百"], [192.6, 192.8, "多"], [192.8, 193.8, "年前,"], [194.16, 194.2, "莱"], [194.2, 194.32, "布"], [194.32, 195.76, "尼"], [195.76, 197.98, "斯"], [197.98, 198.42, "把"], [198.42, 198.88, "问题"], [198.88, 199.16, "推"], [199.16, 199.4, "到了"], [199.4, 199.7, "尽"], [199.7, 200.06, "头,"], [200.3, 200.66, "为什么"], [200.66, 200.88, "有"], [200.88, 201.1, "东"], [201.1, 201.18, "西"], [201.18, 201.48, "存"], [201.48, 201.82, "在,"], [201.92, 202.12, "而"], [202.12, 202.66, "不是"], [202.66, 202.96, "什么"], [202.96, 203.24, "都"], [203.24, 203.54, "没有,"], [203.94, 204.18, "到"], [204.18, 204.68, "今天"], [204.68, 205.06, "没有"], [205.06, 205.24, "人"], [205.24, 205.42, "能"], [205.42, 205.68, "回"], [205.68, 205.96, "答。"]]}, {"start": 205.96, "end": 215.6, "text": "那场四十一年的连胜,可能是一个无法解释的奇迹,也可能只是赢家才有机会回头看。", "words": [[205.96, 206.5, "那"], [206.5, 206.78, "场"], [206.78, 208.56, "四"], [208.56, 208.82, "十"], [208.82, 208.94, "一"], [208.94, 209.22, "年的"], [209.22, 209.56, "连"], [209.56, 209.94, "胜,"], [210.34, 210.44, "可能"], [210.44, 210.72, "是"], [210.72, 210.92, "一个"], [210.92, 211.12, "无"], [211.12, 211.28, "法"], [211.28, 211.48, "解"], [211.48, 211.56, "释"], [211.56, 211.84, "的"], [211.84, 212.06, "奇"], [212.06, 212.38, "迹,"], [212.72, 212.86, "也"], [212.86, 213.18, "可能"], [213.18, 213.48, "只是"], [213.48, 213.72, "赢"], [213.72, 214.02, "家"], [214.02, 214.26, "才"], [214.26, 214.46, "有"], [214.46, 214.66, "机"], [214.66, 214.78, "会"], [214.78, 215.02, "回"], [215.02, 215.22, "头"], [215.22, 215.6, "看。"]]}, {"start": 215.88, "end": 228.18, "text": "不管是哪一种,它到你这里还没有结束,这三种看法你更相信哪一种?不知道,所以继续探索。", "words": [[215.88, 216.12, "不管"], [216.12, 216.38, "是"], [216.38, 216.52, "哪"], [216.52, 216.66, "一"], [216.66, 216.88, "种,"], [217.18, 217.4, "它"], [217.4, 217.58, "到"], [217.58, 217.8, "你"], [217.8, 218.04, "这里"], [218.04, 218.3, "还"], [218.3, 218.5, "没有"], [218.5, 218.86, "结"], [218.86, 219.18, "束,"], [219.6, 219.76, "这"], [219.76, 219.94, "三"], [219.94, 220.1, "种"], [220.1, 220.34, "看"], [220.34, 220.48, "法"], [220.48, 220.72, "你"], [220.72, 220.98, "更"], [220.98, 221.54, "相信"], [221.54, 221.78, "哪"], [221.78, 221.92, "一"], [221.92, 222.28, "种?"], [225.4, 225.86, "不知道,"], [226.36, 226.86, "所以"], [226.86, 227.14, "继"], [227.14, 227.24, "续"], [227.24, 227.6, "探"], [227.6, 228.18, "索。"]]}, {"start": 228.6, "end": 230.8, "text": "下一期你看的世界是真的吗?", "words": [[228.6, 228.8, "下一"], [228.8, 229.04, "期"], [229.04, 229.36, "你看"], [229.36, 229.58, "的"], [229.58, 229.86, "世界"], [229.86, 230.2, "是"], [230.2, 230.42, "真的"], [230.42, 230.8, "吗?"]]}]