[{"start": 4.6, "end": 11.08, "text": "你能出生,靠的是一场持续了四十亿年,一次都没输过的连胜。", "words": [[4.6, 5.08, "你"], [5.08, 5.3, "能"], [5.3, 5.56, "出"], [5.56, 5.92, "生,"], [6.04, 6.22, "靠"], [6.22, 6.5, "的是"], [6.5, 6.76, "一"], [6.76, 6.96, "场"], [6.96, 7.32, "持"], [7.32, 7.5, "续"], [7.5, 7.82, "了"], [7.82, 8.08, "四"], [8.08, 8.32, "十"], [8.32, 8.52, "亿"], [8.52, 8.92, "年,"], [9.22, 9.48, "一次"], [9.48, 9.8, "都"], [9.8, 9.98, "没"], [9.98, 10.14, "输"], [10.14, 10.3, "过"], [10.3, 10.46, "的"], [10.46, 10.7, "连"], [10.7, 11.08, "胜。"]]}, {"start": 11.48, "end": 19.44, "text": "从最早的当细胞开始,你的每一位直系祖先都在留下后代之前活了下来,没有一个例外。", "words": [[11.48, 11.76, "从"], [11.76, 12.08, "最"], [12.08, 12.22, "早"], [12.22, 12.36, "的"], [12.36, 12.46, "当"], [12.46, 12.64, "细"], [12.64, 12.7, "胞"], [12.7, 13.26, "开始,"], [13.58, 13.76, "你的"], [13.76, 14.02, "每"], [14.02, 14.18, "一"], [14.18, 14.3, "位"], [14.3, 14.6, "直"], [14.6, 14.68, "系"], [14.68, 14.96, "祖"], [14.96, 15.18, "先"], [15.18, 15.42, "都"], [15.42, 15.58, "在"], [15.58, 15.84, "留"], [15.84, 16.0, "下"], [16.0, 16.18, "后"], [16.18, 16.3, "代"], [16.3, 16.7, "之前"], [16.7, 17.1, "活"], [17.1, 17.3, "了"], [17.3, 17.48, "下"], [17.48, 18.16, "来,"], [18.38, 18.64, "没有"], [18.64, 18.94, "一个"], [18.94, 19.1, "例"], [19.1, 19.44, "外。"]]}, {"start": 19.88, "end": 26.0, "text": "最后一轮,上一个精子同时出发,只有一个抵达终点,换一个就不是你。", "words": [[19.88, 20.14, "最"], [20.14, 20.24, "后"], [20.24, 20.42, "一"], [20.42, 20.7, "轮,"], [21.0, 21.12, "上"], [21.12, 21.42, "一个"], [21.42, 21.66, "精"], [21.66, 21.76, "子"], [21.76, 22.0, "同"], [22.0, 22.16, "时"], [22.16, 22.44, "出"], [22.44, 22.6, "发,"], [22.78, 22.92, "只有"], [22.92, 23.26, "一个"], [23.26, 23.42, "抵"], [23.42, 23.52, "达"], [23.52, 23.78, "终"], [23.78, 24.02, "点,"], [24.2, 24.48, "换"], [24.48, 24.96, "一个"], [24.96, 25.24, "就"], [25.24, 25.5, "不是"], [25.5, 26.0, "你。"]]}, {"start": 26.0, "end": 29.86, "text": "所以,我为什么会存在?", "words": [[26.0, 26.72, "所以,"], [27.12, 27.68, "我"], [27.68, 28.0, "为什么"], [28.0, 28.26, "会"], [28.26, 28.52, "存"], [28.52, 29.86, "在?"]]}, {"start": 30.62, "end": 37.08, "text": "6600万年前,一颗约十公里宽的小行星撞上地球,恐龙几乎全部消失。", "words": [[30.62, 31.02, "66"], [31.02, 31.14, "00"], [31.14, 31.34, "万"], [31.34, 31.82, "年前,"], [31.96, 32.16, "一"], [32.16, 32.22, "颗"], [32.22, 32.46, "约"], [32.46, 32.8, "十"], [32.8, 32.96, "公"], [32.96, 33.02, "里"], [33.02, 33.18, "宽"], [33.18, 33.38, "的"], [33.38, 33.52, "小"], [33.52, 33.7, "行"], [33.7, 33.84, "星"], [33.84, 34.08, "撞"], [34.08, 34.18, "上"], [34.18, 34.44, "地"], [34.44, 34.82, "球,"], [35.04, 35.24, "恐"], [35.24, 35.42, "龙"], [35.42, 35.72, "几"], [35.72, 35.88, "乎"], [35.88, 36.2, "全部"], [36.2, 36.56, "消"], [36.56, 37.08, "失。"]]}, {"start": 37.32, "end": 41.9, "text": "一些小型哺乳动物活了下来,其中就有我们的元祖。", "words": [[37.32, 37.52, "一些"], [37.52, 37.76, "小"], [37.76, 37.92, "型"], [37.92, 38.18, "哺"], [38.18, 38.18, "乳"], [38.18, 38.48, "动"], [38.48, 38.54, "物"], [38.54, 38.8, "活"], [38.8, 38.96, "了"], [38.96, 39.16, "下"], [39.16, 39.6, "来,"], [39.78, 40.0, "其"], [40.0, 40.26, "中"], [40.26, 40.48, "就"], [40.48, 40.62, "有"], [40.62, 40.82, "我们"], [40.82, 40.98, "的"], [40.98, 41.2, "元"], [41.2, 41.9, "祖。"]]}, {"start": 42.04, "end": 49.74, "text": "有研究估算,只有约13%的地表被这样撞上才会引发大灭绝,它偏偏撞在了那里。", "words": [[42.04, 42.24, "有"], [42.24, 42.46, "研"], [42.46, 42.56, "究"], [42.56, 42.78, "估"], [42.78, 43.08, "算,"], [43.26, 43.5, "只有"], [43.5, 43.74, "约"], [43.74, 44.56, "13"], [44.56, 44.56, "%"], [44.56, 44.88, "的"], [44.88, 45.0, "地"], [45.0, 45.14, "表"], [45.14, 45.36, "被"], [45.36, 45.6, "这样"], [45.6, 45.88, "撞"], [45.88, 46.02, "上"], [46.02, 46.22, "才"], [46.22, 46.38, "会"], [46.38, 46.54, "引"], [46.54, 46.62, "发"], [46.62, 46.88, "大"], [46.88, 47.08, "灭"], [47.08, 47.28, "绝,"], [47.64, 48.22, "它"], [48.22, 48.6, "偏"], [48.6, 48.78, "偏"], [48.78, 48.94, "撞"], [48.94, 49.16, "在"], [49.16, 49.3, "了"], [49.3, 49.46, "那"], [49.46, 49.74, "里。"]]}, {"start": 49.74, "end": 63.92, "text": "再把镜头拉远,巧合变得更夸张,宇宙有一组基本的数字就像一排旋钮,其中一些只要稍微拧一下就不会有你。", "words": [[49.74, 50.34, "再"], [50.34, 50.46, "把"], [50.46, 50.62, "镜"], [50.62, 50.76, "头"], [50.76, 51.0, "拉"], [51.0, 51.2, "远,"], [51.48, 51.64, "巧"], [51.64, 51.82, "合"], [51.82, 52.0, "变"], [52.0, 52.12, "得"], [52.12, 52.28, "更"], [52.28, 52.6, "夸"], [52.6, 53.06, "张,"], [53.32, 53.44, "宇"], [53.44, 53.62, "宙"], [53.62, 53.92, "有一"], [53.92, 54.16, "组"], [54.16, 54.56, "基本"], [54.56, 54.78, "的"], [54.78, 54.98, "数"], [54.98, 55.14, "字"], [55.14, 55.34, "就"], [55.34, 55.46, "像"], [55.46, 55.66, "一"], [55.66, 55.8, "排"], [55.8, 56.08, "旋"], [56.08, 56.44, "钮,"], [56.78, 56.88, "其"], [56.88, 57.06, "中"], [57.06, 57.58, "一些"], [57.58, 58.12, "只"], [58.12, 61.34, "要"], [61.34, 61.62, "稍"], [61.62, 61.84, "微"], [61.84, 61.98, "拧"], [61.98, 62.5, "一下"], [62.5, 62.88, "就"], [62.88, 63.24, "不会"], [63.24, 63.42, "有"], [63.42, 63.92, "你。"]]}, {"start": 64.1, "end": 74.66, "text": "比如,宇宙早期物质的疏密起伏只有大约十万分之一,拧小十倍,聚不成星系,拧大十倍,大量物质会瘫缩成黑洞。", "words": [[64.1, 64.54, "比如,"], [64.8, 64.96, "宇"], [64.96, 65.08, "宙"], [65.08, 65.38, "早"], [65.38, 65.54, "期"], [65.54, 65.76, "物"], [65.76, 65.88, "质"], [65.88, 66.06, "的"], [66.06, 66.2, "疏"], [66.2, 66.3, "密"], [66.3, 66.62, "起"], [66.62, 66.74, "伏"], [66.74, 67.02, "只有"], [67.02, 67.3, "大"], [67.3, 67.46, "约"], [67.46, 67.8, "十"], [67.8, 67.96, "万"], [67.96, 68.16, "分"], [68.16, 68.38, "之"], [68.38, 68.78, "一,"], [68.94, 69.1, "拧"], [69.1, 69.4, "小"], [69.4, 69.64, "十"], [69.64, 69.86, "倍,"], [70.04, 70.12, "聚"], [70.12, 70.3, "不"], [70.3, 70.44, "成"], [70.44, 70.78, "星"], [70.78, 71.02, "系,"], [71.2, 71.42, "拧"], [71.42, 71.66, "大"], [71.66, 71.96, "十"], [71.96, 72.24, "倍,"], [72.44, 72.68, "大"], [72.68, 72.84, "量"], [72.84, 73.08, "物"], [73.08, 73.28, "质"], [73.28, 73.5, "会"], [73.5, 73.76, "瘫"], [73.76, 73.86, "缩"], [73.86, 74.06, "成"], [74.06, 74.28, "黑"], [74.28, 74.66, "洞。"]]}, {"start": 74.66, "end": 87.96, "text": "还有一个故事,1953年天文学家霍伊尔想不通,恒星怎么造出这么多碳?", "words": [[74.66, 75.2, "还有"], [75.2, 75.48, "一个"], [75.48, 75.74, "故"], [75.74, 76.16, "事,"], [76.36, 76.62, "19"], [76.