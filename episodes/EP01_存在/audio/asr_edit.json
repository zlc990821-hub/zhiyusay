.42, 100.66, "象"], [100.66, 100.9, "叫"], [100.9, 101.02, "做"], [101.02, 101.28, "微"], [101.28, 102.28, "条。"]]}, {"start": 102.94, "end": 109.52, "text": "看上去宇宙像是专门为我们准备的,作家道格拉斯·亚丹斯讲过一个故事。", "words": [[102.94, 103.12, "看"], [103.12, 103.38, "上"], [103.38, 103.74, "去"], [103.74, 104.06, "宇"], [104.06, 104.22, "宙"], [104.22, 104.4, "像"], [104.4, 104.58, "是"], [104.58, 104.78, "专"], [104.78, 104.88, "门"], [104.88, 105.06, "为"], [105.06, 105.3, "我们"], [105.3, 105.58, "准"], [105.58, 105.64, "备"], [105.64, 106.28, "的,"], [106.42, 106.6, "作"], [106.6, 106.84, "家"], [106.84, 107.08, "道"], [107.08, 107.24, "格"], [107.24, 107.44, "拉"], [107.44, 107.66, "斯"], [107.66, 107.68, "·"], [107.68, 107.86, "亚"], [107.86, 108.08, "丹"], [108.08, 108.36, "斯"], [108.36, 108.6, "讲"], [108.6, 108.76, "过"], [108.76, 108.94, "一个"], [108.94, 109.24, "故"], [109.24, 109.52, "事。"]]}, {"start": 109.52, "end": 114.58, "text": "一个水坑醒来,发现自己呆的坑形状刚刚好,岩丝合缝。", "words": [[109.52, 110.1, "一个"], [110.1, 110.44, "水"], [110.44, 110.56, "坑"], [110.56, 110.94, "醒"], [110.94, 111.26, "来,"], [111.44, 111.52, "发"], [111.52, 111.62, "现"], [111.62, 111.86, "自己"], [111.86, 112.02, "呆"], [112.02, 112.16, "的"], [112.16, 112.4, "坑"], [112.4, 112.68, "形"], [112.68, 112.78, "状"], [112.78, 113.02, "刚"], [113.02, 113.18, "刚"], [113.18, 113.54, "好,"], [113.78, 113.88, "岩"], [113.88, 114.04, "丝"], [114.04, 114.3, "合"], [114.3, 114.58, "缝。"]]}, {"start": 114.78, "end": 122.1, "text": "他想,这个坑一定是专门为我挖的,直到太阳升起,自己一点点蒸发,他还这么相信。", "words": [[114.78, 115.0, "他"], [115.0, 115.3, "想,"], [115.4, 115.64, "这个"], [115.64, 115.92, "坑"], [115.92, 116.3, "一定"], [116.3, 116.52, "是"], [116.52, 116.78, "专"], [116.78, 116.9, "门"], [116.9, 117.08, "为"], [117.08, 117.26, "我"], [117.26, 117.42, "挖"], [117.42, 117.88, "的,"], [117.96, 118.12, "直"], [118.12, 118.22, "到"], [118.22, 118.42, "太"], [118.42, 118.56, "阳"], [118.56, 118.84, "升"], [118.84, 119.22, "起,"], [119.42, 119.66, "自己"], [119.66, 120.04, "一点"], [120.04, 120.24, "点"], [120.24, 120.5, "蒸"], [120.5, 120.68, "发,"], [120.86, 121.1, "他"], [121.1, 121.36, "还"], [121.36, 121.6, "这么"], [121.6, 122.1, "相信。"]]}, {"start": 122.64, "end": 127.56, "text": "可不是坑适合水,是水本来就顺着坑的形状流成了这样。", "words": [[122.64, 122.84, "可"], [122.84, 123.24, "不是"], [123.24, 123.6, "坑"], [123.6, 123.82, "适"], [123.82, 123.98, "合"], [123.98, 124.24, "水,"], [124.42, 124.56, "是"], [124.56, 124.74, "水"], [124.74, 124.94, "本"], [124.94, 125.12, "来"], [125.12, 125.32, "就"], [125.32, 125.42, "顺"], [125.42, 125.56, "着"], [125.56, 125.7, "坑"], [125.7, 125.94, "的"], [125.94, 126.22, "形"], [126.22, 126.58, "状"], [126.58, 126.9, "流"], [126.9, 127.1, "成"], [127.1, 127.28, "了"], [127.28, 127.56, "这样。"]]}, {"start": 128.16, "end": 134.64, "text": "我们可能也一样,只要在允许生命出现的地方,才会有人问,为什么这么巧?", "words": [[128.16, 128.38, "我们"], [128.38, 128.72, "可能"], [128.72, 129.0, "也"], [129.0, 129.16, "一"], [129.16, 129.52, "样,"], [129.68, 129.98, "只"], [129.98, 130.18, "要"], [130.18, 130.5, "在"], [130.5, 130.78, "允"], [130.78, 131.02, "许"], [131.02, 131.3, "生"], [131.3, 131.42, "命"], [131.42, 131.72, "出"], [131.72, 131.84, "现"], [131.84, 131.98, "的"], [131.98, 132.26, "地方,"], [132.42, 132.6, "才"], [132.6, 132.76, "会"], [132.76, 133.04, "有人"], [133.04, 133.54, "问,"], [133.84, 134.12, "为什么"], [134.12, 134.38, "这么"], [134.38, 134.64, "巧?"]]}, {"start": 134.64, "end": 139.54, "text": "你觉得巧,是因为你只能站在巧的这一边。", "words": [[134.64, 135.36, "你"], [135.36, 135.66, "觉得"], [135.66, 135.94, "巧,"], [136.26, 136.38, "是"], [136.38, 136.54, "因为"], [136.54, 136.76, "你"], [136.76, 136.94, "只"], [136.94, 137.06, "能"], [137.06, 137.28, "站"], [137.28, 137.58, "在"], [137.58, 137.9, "巧"], [137.9, 138.12, "的"], [138.12, 138.28, "这"], [138.28, 138.4, "一"], [138.4, 139.54, "边。"]]}, {"start": 140.0, "end": 146.1, "text": "这叫人则原理,如果宇宙有无数个,绝大多数理根本没有人提问。", "words": [[140.0, 140.06, "这"], [140.06, 140.32, "叫"], [140.32, 140.58, "人"], [140.58, 140.8, "则"], [140.8, 141.06, "原"], [141.06, 141.32, "理,"], [141.7, 142.18, "如果"], [142.18, 142.44, "宇"], [142.44, 142.5, "宙"], [142.5, 142.76, "有"], [142.76, 142.98, "无"], [142.98, 143.14, "数"], [143.14, 143.5, "个,"], [143.62, 143.74, "绝"], [143.74, 143.9, "大"], [143.9, 144.08, "多"], [144.08, 144.24, "数"], [144.24, 144.44, "理"], [144.44, 144.74, "根"], [144.74, 144.86, "本"], [144.86, 145.18, "没有"], [145.18, 145.38, "人"], [145.38, 145.64, "提"], [145.64, 146.1, "问。"]]}, {"start": 146.32, "end": 152.14, "text": "不过多重宇宙至今无法验证,也有物理学家认为微条被夸大了。", "words": [[146.32, 146.58, "不"], [146.58, 146.82, "过"], [146.82, 147.04, "多"], [147.04, 147.16, "重"], [147.16, 147.38, "宇"], [147.38, 147.48, "宙"], [147.48, 147.74, "至"], [147.74, 147.92, "今"], [147.92, 148.26, "无"], [148.26, 148.44, "法"], [148.44, 148.72, "验"], [148.72, 148.88, "证,"], [149.04, 149.14, "也"], [149.14, 149.26, "有"], [149.26, 149.44, "物"], [149.44, 149.54, "理"], [149.54, 149.64, "学"], [149.64, 149.76, "家"], [149.76, 150.0, "认"], [150.0, 150.18, "为"], [150.18, 150.48, "微"], [150.48, 150.66, "条"], [150.66, 151.02, "被"], [151.02, 151.28, "夸"], [151.28, 151.44, "大"], [151.44, 152.14, "了。"]]}, {"start": 152.34, "end": 157.46, "text": "所以对为什么这么巧大致有三种看法,成熟偶然。", "words": [[152.34, 152.82, "所以"], [152.82, 153.24, "对"], [153.24, 153.76, "为什么"], [153.76, 154.02, "这么"], [154.02, 154.36, "巧"], [154.36, 154.7, "大"], [154.7, 154.82, "致"], [154.82, 155.2, "有"], [155.2, 155.52, "三"], [155.52, 155.7, "种"], [155.7, 156.0, "看"], [156.0, 156.28, "法,"], [156.34, 156.62, "成"], [156.62, 156.74, "熟"], [156.74, 157.0, "偶"], [157.0, 157.46, "然。"]]}, {"start": 157.68, "end": 163.36, "text": "无数宇宙中我们刚好在这一个,或者还有更深的原因没有被找到。", "words": [[157.68, 157.96, "无"], [157.96, 158.08, "数"], [158.08, 158.32, "宇"], [158.32, 158.42, "宙"], [158.42, 158.68, "中"], [158.68, 158.94, "我们"], [158.94, 159.14, "刚"], [159.14, 159.38, "好"], [159.38, 159.56, "在"], [159.56, 159.76, "这"], [159.76, 160.32, "一个,"], [160.6, 161.02, "或者"], [161.02, 161.46, "还有"], [161.46, 161.8, "更"], [161.8, 161.9, "深"], [161.9, 162.12, "的"], [162.12, 162.32, "原因"], [162.32, 162.66, "没有"], [162.66, 162.94, "被"], [162.94, 163.1, "找"], [163.1, 163.36, "到。"]]}, {"start": 165.38000000000002, "end": 169.24, "text": "但就算人则原理是对的,也只解释了一半。", "words": [[165.38000000000002, 165.86, "但"], [165.86, 166.22, "就"], [166.22, 166.32, "算"], [166.32, 166.54, "人"], [166.54, 166.7, "则"], [166.7, 166.94, "原"], [166.94, 167.12, "理"], [167.12, 167.32, "是"], [167.32, 167.5, "对"], [167.5, 167.9, "的,"], [168.0, 168.1, "也"], [168.1, 168.22, "只"], [168.22, 168.46, "解"], [168.46, 168.56, "释"], [168.56, 168.74, "了"], [168.74, 168.86, "一"], [168.86, 169.24, "半。"]]}, {"start": 169.44, "end": 172.36, "text": "他说明不了为什么会有宇宙。", "words": [[169.44, 169.58, "他"], [169.58, 169.72, "说"], [169.72, 169.9, "明"], [169.9, 170.24, "不了"], [170.24, 170.78, "为什么"], [170.78, 171.06, "会"], [171.06, 171.18, "有"], [171.18, 171.44, "宇"], [171.44, 172.36, "宙。"]]}, {"start": 172.62, "end": 179.6, "text": "三百多年前,莱布尼茨把问题推到了尽头,", "words": [[172.62, 172.64, "三"], [172.64, 172.72, "百"], [172.72, 172.88, "多"], [172.88, 173.56, "年前,"], [174.18, 174.36, "莱"], [174.36, 174.48, "布"], [174.48, 175.3, "尼"], [175.3, 177.52, "茨"], [177.52, 177.92, "把"], [177.92, 178.42, "问题"], [178.42, 178.68, "推"], [178.68, 178.92, "到了"], [178.92, 179.24, "尽"], [179.24, 179.6, "头,"]]}, {"start": 179.82, "end": 185.6, "text": "为什么有东西存在,而不是什么都没有。到今天没有人能回答。", "words": [[179.82, 180.18, "为什么"], [180.18, 180.42, "有"], [180.42, 180.62, "东"], [180.62, 180.7, "西"], [180.7, 181.02, "存"], [181.02, 181.32, "在,"], [181.42, 181.66, "而"], [181.66, 182.12, "不是"], [182.12, 182.5, "什么"], [182.5, 182.78, "都"], [182.78, 183.08, "没有。"], [183.5, 183.72, "到"], [183.72, 184.18, "今天"], [184.18, 184.6, "没有"], [184.6, 184.76, "人"], [184.76, 184.94, "能"], [184.94, 185.2, "回"], [185.2, 185.6, "答。"]]}, {"start": 186.96, "end": 192.98, "text": "那场四十一年的连胜可能是一个无法解释的奇迹。", "words": [[186.96, 187.2, "那"], [187.2, 187.5, "场"], [187.5, 189.34, "四"], [189.34, 189.56, "十"], [189.56, 189.72, "一"], [189.72, 189.96, "年的"], [189.96, 190.32, "连"], [190.32, 190.56, "胜"], [190.56, 191.14, "可能"], [191.14, 191.44, "是"], [191.44, 191.64, "一个"], [191.64, 191.86, "无"], [191.86, 191.98, "法"], [191.98, 192.22, "解"], [192.22, 192.28, "释"], [192.28, 192.52, "的"], [192.52, 192.8, "奇"], [192.8, 192.98, "迹。"]]}, {"start": 192.98, "end": 196.98, "text": "也可能只是赢家才有机会回头看。", "words": [[192.98, 193.5, "也"], [193.5, 193.9, "可能"], [193.9, 194.22, "只是"], [194.22, 194.48, "赢"], [194.48, 194.72, "家"], [194.72, 194.98, "才"], [194.98, 195.18, "有"], [195.18, 195.38, "机"], [195.38, 195.5, "会"], [195.5, 195.76, "回"], [195.76, 195.96, "头"], [195.96, 196.98, "看。"]]}, {"start": 197.4, "end": 200.8, "text": "不管是哪一种,它到你这里还没有结束。", "words": [[197.4, 197.46, "不管"], [197.46, 197.72, "是"], [197.72, 197.84, "哪"], [197.84, 198.0, "一"], [198.0, 198.24, "种,"], [198.52, 198.72, "它"], [198.72, 198.9, "到"], [198.9, 199.12, "你"], [199.12, 199.36, "这里"], [199.36, 199.64, "还"], [199.64, 199.84, "没有"], [199.84, 200.18, "结"], [200.18, 200.8, "束。"]]}, {"start": 201.3, "end": 203.8, "text": "这三种看法你更相信哪一种?", "words": [[201.3, 201.58, "这"], [201.58, 201.84, "三"], [201.84, 201.98, "种"], [201.98, 202.22, "看"], [202.22, 202.34, "法"], [202.34, 202.54, "你"], [202.54, 202.72, "更"], [202.72, 202.98, "相信"], [202.98, 203.22, "哪"], [203.22, 203.36, "一"], [203.36, 203.8, "种?"]]}, {"start": 204.61999999999998, "end": 208.24, "text": "不知道,所以继续探索。", "words": [[204.61999999999998, 205.14, "不知道,"], [206.02, 206.5, "所以"], [206.5, 206.8, "继"], [206.8, 206.9, "续"], [206.9, 207.24, "探"], [207.24, 208.24, "索。"]]}, {"start": 209.3, "end": 211.4, "text": "下一期你看的世界是真的吗?", "words": [[209.3, 209.46, "下一"], [209.46, 209.7, "期"], [209.7, 210.06, "你看"], [210.06, 210.26, "的"], [210.26, 210.52, "世界"], [210.52, 210.86, "是"], [210.86, 211.06, "真的"], [211.06, 211.4, "吗?"]]}]