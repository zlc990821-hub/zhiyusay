[{"start": 2.7799999999999994, "end": 9.2, "text": "你能出生,靠的是一场持续了四十亿年﹔一次都没输过的连胜。", "words": [[2.7799999999999994, 3.26, "你"], [3.26, 3.48, "能"], [3.48, 3.74, "出"], [3.74, 4.08, "生,"], [4.3, 4.4, "靠"], [4.4, 4.7, "的是"], [4.7, 4.98, "一"], [4.98, 5.14, "场"], [5.14, 5.5, "持"], [5.5, 5.68, "续"], [5.68, 6.04, "了"], [6.04, 6.24, "四"], [6.24, 6.48, "十"], [6.48, 6.68, "亿"], [6.68, 7.1, "年"], [7.1, 7.6, "﹔"], [7.6, 7.62, "一次"], [7.62, 8.0, "都"], [8.0, 8.16, "没"], [8.16, 8.34, "输"], [8.34, 8.46, "过"], [8.46, 8.64, "的"], [8.64, 8.88, "连"], [8.88, 9.2, "胜。"]]}, {"start": 9.66, "end": 16.34, "text": "从最早的当细胞开始,你的每一位直系祖先都在留下后代之前活了下来。", "words": [[9.66, 9.94, "从"], [9.94, 10.24, "最"], [10.24, 10.38, "早"], [10.38, 10.54, "的"], [10.54, 10.64, "当"], [10.64, 10.82, "细"], [10.82, 10.88, "胞"], [10.88, 11.5, "开始,"], [11.7, 11.94, "你的"], [11.94, 12.2, "每"], [12.2, 12.36, "一"], [12.36, 12.48, "位"], [12.48, 12.78, "直"], [12.78, 12.86, "系"], [12.86, 13.12, "祖"], [13.12, 13.36, "先"], [13.36, 13.66, "都"], [13.66, 13.76, "在"], [13.76, 13.96, "留"], [13.96, 14.18, "下"], [14.18, 14.36, "后"], [14.36, 14.48, "代"], [14.48, 14.9, "之前"], [14.9, 15.28, "活"], [15.28, 15.48, "了"], [15.48, 15.66, "下"], [15.66, 16.34, "来。"]]}, {"start": 16.54, "end": 22.16, "text": "没有一个例外。最后一轮,上一个精子同时出发,只有一个抵达终点,", "words": [[16.54, 16.8, "没有"], [16.8, 17.12, "一个"], [17.12, 17.28, "例"], [17.28, 17.58, "外。"], [18.04, 18.3, "最"], [18.3, 18.42, "后"], [18.42, 18.6, "一"], [18.6, 18.88, "轮,"], [19.18, 19.32, "上"], [19.32, 19.6, "一个"], [19.6, 19.84, "精"], [19.84, 19.94, "子"], [19.94, 20.16, "同"], [20.16, 20.32, "时"], [20.32, 20.6, "出"], [20.6, 20.76, "发,"], [20.84, 21.1, "只有"], [21.1, 21.42, "一个"], [21.42, 21.6, "抵"], [21.6, 21.7, "达"], [21.7, 21.92, "终"], [21.92, 22.16, "点,"]]}, {"start": 22.36, "end": 27.2, "text": "换一个就不是你。所以,我为什么会存在?", "words": [[22.36, 22.64, "换"], [22.64, 23.14, "一个"], [23.14, 23.38, "就"], [23.38, 23.68, "不是"], [23.68, 24.16, "你。"], [24.54, 25.02, "所以,"], [25.34, 25.86, "我"], [25.86, 26.18, "为什么"], [26.18, 2