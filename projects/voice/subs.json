[
 {
  "a": 0.8,
  "b": 2.8,
  "text": "你觉得一段感情里",
  "speech_a": 0.88,
  "speech_b": 2.66
 },
 {
  "a": 2.84,
  "b": 5.12,
  "text": "最让人崩溃的瞬间是什么？",
  "para_end": true,
  "speech_a": 2.92,
  "speech_b": 4.8
 },
 {
  "a": 5.16,
  "b": 7.2,
  "text": "很多人会说是{背叛}",
  "speech_a": 5.24,
  "speech_b": 7.08
 },
 {
  "a": 7.24,
  "b": 8.88,
  "text": "是激烈的{争吵}",
  "para_end": true,
  "speech_a": 7.32,
  "speech_b": 8.78
 },
 {
  "a": 8.92,
  "b": 10.14,
  "text": "但慢慢才明白",
  "speech_a": 9.0,
  "speech_b": 9.9
 },
 {
  "a": 10.18,
  "b": 11.72,
  "text": "最摧毁一段关系的",
  "speech_a": 10.26,
  "speech_b": 11.8
 },
 {
  "a": 11.76,
  "b": 13.74,
  "text": "往往不是歇斯底里的冲突",
  "para_end": true,
  "speech_a": 11.84,
  "speech_b": 13.68
 },
 {
  "a": 13.78,
  "b": 15.9,
  "text": "而是两个人明明心里还有爱",
  "speech_a": 13.86,
  "speech_b": 15.7
 },
 {
  "a": 15.94,
  "b": 18.28,
  "text": "却在长久的{沉默失语}当中",
  "speech_a": 16.02,
  "speech_b": 18.24
 },
 {
  "a": 18.32,
  "b": 19.78,
  "text": "慢慢消耗掉彼此",
  "para_end": true,
  "speech_a": 18.4,
  "speech_b": 19.76
 },
 {
  "a": 19.82,
  "b": 22.62,
  "text": "就像{俄耳甫斯}的神话，不是不爱",
  "speech_a": 19.9,
  "speech_b": 22.46
 },
 {
  "a": 22.66,
  "b": 24.18,
  "text": "是漆黑的隧道里",
  "speech_a": 22.74,
  "speech_b": 24.18
 },
 {
  "a": 24.220000000000002,
  "b": 25.88,
  "text": "两个人没有办法对话",
  "speech_a": 24.3,
  "speech_b": 25.72
 },
 {
  "a": 25.92,
  "b": 27.28,
  "text": "最后亲手失去对方",
  "para_end": true,
  "speech_a": 26.0,
  "speech_b": 27.4
 },
 {
  "a": 27.32,
  "b": 29.62,
  "text": "我们很习惯把所有走散",
  "speech_a": 27.4,
  "speech_b": 29.48
 },
 {
  "a": 29.66,
  "b": 31.34,
  "text": "简单归为一句{不够爱}",
  "para_end": true,
  "speech_a": 29.74,
  "speech_b": 31.26
 },
 {
  "a": 31.380000000000003,
  "b": 34.36,
  "text": "但爱只是内心的一种感受，亲密关系",
  "speech_a": 31.46,
  "speech_b": 34.38
 },
 {
  "a": 34.4,
  "b": 37.44,
  "text": "是两个人之间{真实的互动}。心里有爱",
  "speech_a": 34.48,
  "speech_b": 37.44
 },
 {
  "a": 37.480000000000004,
  "b": 39.84,
  "text": "不等于关系就可以自动存活",
  "para_end": true,
  "speech_a": 37.56,
  "speech_b": 39.56
 },
 {
  "a": 39.88,
  "b": 41.22,
  "text": "从心理学上讲",
  "speech_a": 39.96,
  "speech_b": 41.0
 },
 {
  "a": 41.260000000000005,
  "b": 44.02,
  "text": "每个人的内心都是一座封闭的{孤岛}",
  "para_end": true,
  "speech_a": 41.34,
  "speech_b": 43.56
 },
 {
  "a": 44.06,
  "b": 46.46,
  "text": "你的疲惫、你的恐慌、你的难堪",
  "speech_a": 44.14,
  "speech_b": 46.42
 },
 {
  "a": 46.5,
  "b": 48.54,
  "text": "全部都困在你的内在世界",
  "speech_a": 46.58,
  "speech_b": 48.32
 },
 {
  "a": 48.58,
  "b": 51.12,
  "text": "它不会自动同步到另一个人的心里",
  "para_end": true,
  "speech_a": 48.66,
  "speech_b": 51.0
 },
 {
  "a": 51.160000000000004,
  "b": 52.68,
  "text": "就算对方再在乎你",
  "speech_a": 51.24,
  "speech_b": 52.8
 },
 {
  "a": 52.72,
  "b": 53.88,
  "text": "也没有{读心术}",
  "speech_a": 52.8,
  "speech_b": 54.0
 },
 {
  "a": 53.92,
  "b": 55.82,
  "text": "一旦选择闭口不说",
  "speech_a": 54.0,
  "speech_b": 55.78
 },
 {
  "a": 55.86,
  "b": 58.78,
  "text": "你们之间就会竖起一道感知的{高墙}",
  "para_end": true,
  "speech_a": 55.94,
  "speech_b": 58.7
 },
 {
  "a": 58.82,
  "b": 60.9,
  "text": "哲学上有一个很现实的真相",
  "speech_a": 58.9,
  "speech_b": 60.9
 },
 {
  "a": 60.940000000000005,
  "b": 63.62,
  "text": "人的脆弱，无法靠想象被看见",
  "speech_a": 61.02,
  "speech_b": 63.58
 },
 {
  "a": 63.660000000000004,
  "b": 65.9,
  "text": "它必须依靠{语言}来传递",
  "para_end": true,
  "speech_a": 63.74,
  "speech_b": 65.7
 },
 {
  "a": 65.94,
  "b": 68.58,
  "text": "关系里有两种非常隐蔽的{自我感动}",
  "speech_a": 66.02,
  "speech_b": 68.48
 },
 {
  "a": 68.62,
  "b": 70.66,
  "text": "正在悄悄毁掉很多感情",
  "para_end": true,
  "speech_a": 68.7,
  "speech_b": 70.42
 },
 {
  "a": 70.7,
  "b": 73.3,
  "text": "一种是把{独自硬扛}当成担当",
  "para_end": true,
  "speech_a": 70.78,
  "speech_b": 73.22
 },
 {
  "a": 73.34,
  "b": 75.14,
  "text": "遇到压力就关上心门",
  "speech_a": 73.42,
  "speech_b": 75.04
 },
 {
  "a": 75.18,
  "b": 76.78,
  "text": "什么都自己消化",
  "speech_a": 75.26,
  "speech_b": 76.5
 },
 {
  "a": 76.82000000000001,
  "b": 77.86,
  "text": "内心的逻辑是",
  "speech_a": 76.9,
  "speech_b": 77.84
 },
 {
  "a": 77.9,
  "b": 79.0,
  "text": "我默默努力",
  "speech_a": 77.98,
  "speech_b": 78.9
 },
 {
  "a": 79.04,
  "b": 80.04,
  "text": "我扛下所有",
  "speech_a": 79.12,
  "speech_b": 79.94
 },
 {
  "a": 80.08,
  "b": 80.78,
  "text": "就是对你好",
  "para_end": true,
  "speech_a": 80.16,
  "speech_b": 80.9
 },
 {
  "a": 80.82000000000001,
  "b": 83.52,
  "text": "可这其实是一种关系里的{傲慢}",
  "speech_a": 80.9,
  "speech_b": 83.54
 },
 {
  "a": 83.56,
  "b": 85.54,
  "text": "你在用自己的标准诠释爱",
  "speech_a": 83.64,
  "speech_b": 85.5
 },
 {
  "a": 85.58,
  "b": 87.72,
  "text": "却忽略了对方的真实感受",
  "para_end": true,
  "speech_a": 85.66,
  "speech_b": 87.66
 },
 {
  "a": 87.76,
  "b": 88.88,
  "text": "你以为是保护",
  "speech_a": 87.84,
  "speech_b": 88.84
 },
 {
  "a": 88.92,
  "b": 92.02,
  "text": "对方感受到的却是被隔绝、被排斥",
  "speech_a": 89.0,
  "speech_b": 91.92
 },
 {
  "a": 92.06,
  "b": 93.78,
  "text": "被挡在你的生活之外",
  "para_end": true,
  "speech_a": 92.14,
  "speech_b": 93.62
 },
 {
  "a": 93.82000000000001,
  "b": 96.62,
  "text": "还有一种，把{隐忍克制}当作体谅",
  "para_end": true,
  "speech_a": 93.9,
  "speech_b": 96.54
 },
 {
  "a": 96.66,
  "b": 97.96,
  "text": "受了委屈不吭声",
  "speech_a": 96.74,
  "speech_b": 97.88
 },
 {
  "a": 98.0,
  "b": 99.5,
  "text": "有了期待不表达",
  "speech_a": 98.08,
  "speech_b": 99.44
 },
 {
  "a": 99.54,
  "b": 100.64,
  "text": "害怕添麻烦",
  "speech_a": 99.62,
  "speech_b": 100.48
 },
 {
  "a": 100.68,
  "b": 101.96,
  "text": "害怕显得矫情",
  "para_end": true,
  "speech_a": 100.76,
  "speech_b": 101.82
 },
 {
  "a": 102.0,
  "b": 105.1,
  "text": "但情绪不会因为你压抑就凭空消失",
  "speech_a": 102.08,
  "speech_b": 104.98
 },
 {
  "a": 105.14,
  "b": 106.62,
  "text": "它只会不断堆积",
  "speech_a": 105.22,
  "speech_b": 106.52
 },
 {
  "a": 106.66,
  "b": 108.14,
  "text": "变成失望、隔阂",
  "speech_a": 106.74,
  "speech_b": 108.26
 },
 {
  "a": 108.18,
  "b": 109.16,
  "text": "等到{临界点}",
  "speech_a": 108.26,
  "speech_b": 109.28
 },
 {
  "a": 109.2,
  "b": 111.68,
  "text": "用伤害性的方式爆发出来",
  "para_end": true,
  "speech_a": 109.28,
  "speech_b": 111.24
 },
 {
  "a": 111.72,
  "b": 114.56,
  "text": "于是就形成了非常拧巴的{双向困境}",
  "para_end": true,
  "speech_a": 111.8,
  "speech_b": 114.64
 },
 {
  "a": 114.60000000000001,
  "b": 118.02,
  "text": "一个人活在我心里都是为我们好的精神世界",
  "para_end": true,
  "speech_a": 114.68,
  "speech_b": 117.78
 },
 {
  "a": 118.06,
  "b": 119.84,
  "text": "另一个人接收不到信号",
  "speech_a": 118.14,
  "speech_b": 119.88
 },
 {
  "a": 119.88,
  "b": 122.72,
  "text": "活在我是不是不被需要的怀疑里",
  "para_end": true,
  "speech_a": 119.96,
  "speech_b": 122.5
 },
 {
  "a": 122.76,
  "b": 124.26,
  "text": "肉身朝夕相处",
  "speech_a": 122.84,
  "speech_b": 124.14
 },
 {
  "a": 124.3,
  "b": 126.88,
  "text": "精神却隔在漆黑的隧道两端",
  "para_end": true,
  "speech_a": 124.38,
  "speech_b": 126.56
 },
 {
  "a": 126.92,
  "b": 129.28,
  "text": "我们总幻想所谓的{心有灵犀}",
  "speech_a": 127.0,
  "speech_b": 129.14
 },
 {
  "a": 129.32,
  "b": 131.88,
  "text": "期待对方读懂所有欲言又止",
  "para_end": true,
  "speech_a": 129.4,
  "speech_b": 131.85
 },
 {
  "a": 131.92,
  "b": 133.52,
  "text": "可存在主义告诉我们",
  "speech_a": 132.0,
  "speech_b": 133.36
 },
 {
  "a": 133.55999999999997,
  "b": 136.28,
  "text": "人和人本质上就无法做到完全互通",
  "para_end": true,
  "speech_a": 133.64,
  "speech_b": 136.4
 },
 {
  "a": 136.32,
  "b": 137.72,
  "text": "没有任何人",
  "speech_a": 136.4,
  "speech_b": 137.84
 },
 {
  "a": 137.76,
  "b": 139.52,
  "text": "能够穿透内心的黑暗",
  "speech_a": 137.84,
  "speech_b": 139.62
 },
 {
  "a": 139.55999999999997,
  "b": 141.6,
  "text": "看透你全部的挣扎",
  "para_end": true,
  "speech_a": 139.64,
  "speech_b": 141.4
 },
 {
  "a": 141.64,
  "b": 142.9,
  "text": "所谓灵魂契合",
  "speech_a": 141.72,
  "speech_b": 142.82
 },
 {
  "a": 142.94,
  "b": 144.12,
  "text": "不是天生就懂",
  "speech_a": 143.02,
  "speech_b": 143.98
 },
 {
  "a": 144.16,
  "b": 146.1,
  "text": "是靠{袒露}、靠{表达}",
  "speech_a": 144.24,
  "speech_b": 146.08
 },
 {
  "a": 146.14,
  "b": 148.04,
  "text": "一点点搭建出来的",
  "para_end": true,
  "speech_a": 146.22,
  "speech_b": 147.48
 },
 {
  "a": 148.07999999999998,
  "b": 149.96,
  "text": "沉默看上去风平浪静",
  "speech_a": 148.16,
  "speech_b": 149.94
 },
 {
  "a": 150.0,
  "b": 152.16,
  "text": "底下全是看不见的{损耗}",
  "speech_a": 150.08,
  "speech_b": 152.14
 },
 {
  "a": 152.2,
  "b": 154.88,
  "text": "那些没有说出口的心事，不会化解",
  "speech_a": 152.28,
  "speech_b": 154.86
 },
 {
  "a": 154.92,
  "b": 156.54,
  "text": "只会啃噬爱意",
  "para_end": true,
  "speech_a": 155.0,
  "speech_b": 156.24
 },
 {
  "a": 156.57999999999998,
  "b": 159.94,
  "text": "当然我并不是要去指责习惯沉默的人",
  "para_end": true,
  "speech_a": 156.66,
  "speech_b": 159.48
 },
 {
  "a": 159.98,
  "b": 161.48,
  "text": "很多时候不愿开口",
  "speech_a": 160.06,
  "speech_b": 161.44
 },
 {
  "a": 161.51999999999998,
  "b": 163.34,
  "text": "只是本能的{自我保护}",
  "para_end": true,
  "speech_a": 161.6,
  "speech_b": 163.36
 },
 {
  "a": 163.38,
  "b": 166.22,
  "text": "害怕把狼狈摊开之后得不到接纳",
  "speech_a": 163.46,
  "speech_b": 166.34
 },
 {
  "a": 166.26,
  "b": 168.38,
  "text": "害怕自己的脆弱被轻视",
  "speech_a": 166.34,
  "speech_b": 168.39
 },
 {
  "a": 168.42,
  "b": 170.22,
  "text": "害怕成为对方的负担",
  "para_end": true,
  "speech_a": 168.5,
  "speech_b": 170.08
 },
 {
  "a": 170.26,
  "b": 172.1,
  "text": "但亲密关系存在的意义",
  "speech_a": 170.34,
  "speech_b": 172.22
 },
 {
  "a": 172.14,
  "b": 174.76,
  "text": "本就不是两个完美的人各自独行",
  "para_end": true,
  "speech_a": 172.22,
  "speech_b": 174.7
 },
 {
  "a": 174.79999999999998,
  "b": 176.04,
  "text": "而是允许彼此",
  "speech_a": 174.88,
  "speech_b": 176.16
 },
 {
  "a": 176.07999999999998,
  "b": 177.74,
  "text": "{不用时刻强大}",
  "para_end": true,
  "speech_a": 176.16,
  "speech_b": 177.64
 },
 {
  "a": 177.78,
  "b": 179.98,
  "text": "爱不只是心底无声的牺牲",
  "speech_a": 177.86,
  "speech_b": 179.86
 },
 {
  "a": 180.01999999999998,
  "b": 181.64,
  "text": "{爱需要被听见}",
  "para_end": true,
  "speech_a": 180.1,
  "speech_b": 181.52
 },
 {
  "a": 181.67999999999998,
  "b": 183.4,
  "text": "不用华丽漂亮的言辞",
  "speech_a": 181.76,
  "speech_b": 183.38
 },
 {
  "a": 183.44,
  "b": 185.18,
  "text": "不必伪装情绪稳定",
  "para_end": true,
  "speech_a": 183.52,
  "speech_b": 185.1
 },
 {
  "a": 185.22,
  "b": 186.26,
  "text": "可以直白的说",
  "speech_a": 185.3,
  "speech_b": 186.26
 },
 {
  "a": 186.29999999999998,
  "b": 187.42,
  "text": "{我现在很难",
  "speech_a": 186.38,
  "speech_b": 187.32
 },
 {
  "a": 187.45999999999998,
  "b": 188.52,
  "text": "我有点害怕}",
  "para_end": true,
  "speech_a": 187.54,
  "speech_b": 188.48
 },
 {
  "a": 188.55999999999997,
  "b": 189.74,
  "text": "也可以坦诚的说",
  "speech_a": 188.64,
  "speech_b": 189.66
 },
 {
  "a": 189.78,
  "b": 191.8,
  "text": "{你走得太快，我跟不上}",
  "para_end": true,
  "speech_a": 189.86,
  "speech_b": 191.58
 },
 {
  "a": 191.83999999999997,
  "b": 193.88,
  "text": "不要高估一个人的猜测能力",
  "speech_a": 191.92,
  "speech_b": 193.86
 },
 {
  "a": 193.92,
  "b": 196.06,
  "text": "也不要低估笨拙表达的力量",
  "para_end": true,
  "speech_a": 194.0,
  "speech_b": 196.18
 },
 {
  "a": 196.1,
  "b": 200.08,
  "text": "不要等到爱在寂静中化为乌有才追悔莫及",
  "para_end": true,
  "speech_a": 196.18,
  "speech_b": 200.2
 },
 {
  "a": 200.11999999999998,
  "b": 202.78,
  "text": "处在关系那条黑暗隧道里的时候",
  "speech_a": 200.2,
  "speech_b": 202.52
 },
 {
  "a": 202.82,
  "b": 205.07,
  "text": "记得，{要发出你的声音}",
  "para_end": true,
  "speech_a": 202.9,
  "speech_b": 204.72
 }
]